# E2E test credentials — copy to .env.e2e and fill in.
# These accounts must already exist (email-confirmed) in Lovable Cloud
# with the appropriate role granted via the Admin Dashboard.

# Optional: override the URL the tests hit. Defaults to http://localhost:8080
# Set this to your published URL to run against production:
# E2E_BASE_URL=https://google-delivery-spark.lovable.app

E2E_CUSTOMER_EMAIL=
E2E_CUSTOMER_PASSWORD=

E2E_DRIVER_EMAIL=
E2E_DRIVER_PASSWORD=

E2E_RESTAURANT_EMAIL=
E2E_RESTAURANT_PASSWORD=

E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
